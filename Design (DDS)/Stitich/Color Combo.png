<rect x="498" y="280" width="144" height="100" rx="8" fill="#FEF3C7" stroke="#D97706" stroke-width="1.5" style="fill:rgb(254, 243, 199);stroke:rgb(217, 119, 6);color:rgb(255, 255, 255);stroke-width:1.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
