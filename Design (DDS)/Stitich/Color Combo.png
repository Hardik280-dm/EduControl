<path d="M315 295 Q320 315 310 340" fill="none" stroke="#FDE68A" stroke-width="3" stroke-linecap="round" stroke-opacity="0.8" style="fill:none;stroke:rgb(253, 230, 138);color:rgb(255, 255, 255);stroke-width:3px;stroke-linecap:round;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
<!-- Stem -->
